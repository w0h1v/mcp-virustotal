{
  "name": "@burtthecoder/mcp-virustotal",
  "mcpName": "io.github.BurtTheCoder/virustotal",
  "version": "1.0.30",
  "description": "MCP server for VirusTotal API integration",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "mcp-virustotal": "build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "start": "node build/index.js",
    "dev": "tsc -w",
    "test": "npm run build && node --test tests/*.test.mjs",
    "smoke": "npm run build && node scripts/smoke-test.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "virustotal",
    "security",
    "threat-intelligence",
    "malware-analysis",
    "dfir",
    "ioc",
    "ai-agents",
    "claude",
    "claude-code",
    "claude-desktop"
  ],
  "author": "BurtTheCoder",
  "license": "MIT",
  "homepage": "https://w0h1v.github.io/mcp-virustotal/",
  "bugs": {
    "url": "https://github.com/w0h1v/mcp-virustotal/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/w0h1v/mcp-virustotal.git"
  },
  "dependencies": {
    "axios": "1.20.0",
    "dotenv": "^18.0.6",
    "fastmcp": "~3.25.4",
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "typescript": "^5.3.3"
  }
}
